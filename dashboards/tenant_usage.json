{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "FinText Alpha Vectorizer — Institutional Tenant Quota, API-Key Audit & Ingestion Telemetry",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "description": "Current UTC monthly request consumption per institutional tenant organization. Evaluated against plan quotas for early capacity exhaustion detection.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Requests (Month-to-Date)",
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "pointSize": 5,
            "showPoints": "never"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1600000 },
              { "color": "red", "value": 1900000 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "max"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "fintext_tenant_requests_month",
          "legendFormat": "{{org}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Tenant Monthly Request Volume vs Quota Cap",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "description": "Remaining monthly quota headroom percentage per tenant (100% = fully available, 0% = quota exhausted). Triggers proactive support outreach when <= 20%.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 20 },
              { "color": "green", "value": 50 }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 2,
      "options": {
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "fintext_tenant_headroom_pct",
          "legendFormat": "{{org}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Tenant Quota Headroom Gauge (%)",
      "type": "gauge"
    },
    {
      "datasource": "Prometheus",
      "description": "Rate-limit (HTTP 429) hits per second by tenant organization. Spikes identify uncoordinated backtest parallelization or runaway bots.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Rejections / sec",
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "id": 3,
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "max"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "rate(fintext_rate_limit_hits_total[5m])",
          "legendFormat": "{{org}} (429)",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "HTTP 429 Rate-Limit Rejections by Tenant",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "description": "HTTP 403 Forbidden rejections caused by tenant IP CIDR whitelist enforcement. Vital diagnostic for day-2 client connectivity troubleshooting.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Rejections / sec",
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.1 },
              { "color": "red", "value": 1.0 }
            ]
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "id": 4,
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "max"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "rate(fintext_ipwhitelist_rejects_total[5m])",
          "legendFormat": "{{org}} (403 Whitelist)",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "HTTP 403 IP-Whitelist Access Rejects by Tenant",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "description": "Per-source P95 event ingestion lag (source_published_ts to db_commit_ts in seconds) for SEC EDGAR, FOMC, Finnhub WS, Polygon WS, and Corporate Actions.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Lag (Seconds)",
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.25 },
              { "color": "red", "value": 1.0 }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 17 },
      "id": 5,
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "p95", "max"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum(rate(fintext_ingestion_event_lag_seconds_bucket[5m])) by (le, source))",
          "legendFormat": "{{source}} (P95 Lag)",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Per-Source Ingestion Event Lag P95 (Source TS -> DB Commit TS)",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "description": "Per-source P95 HTTP/WebSocket batch fetch duration (seconds). Measures raw external network + provider API latency before normalization.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Fetch Duration (Seconds)",
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "red", "value": 2.0 }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 17 },
      "id": 6,
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "p95", "max"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum(rate(fintext_ingestion_fetch_duration_seconds_bucket[5m])) by (le, source))",
          "legendFormat": "{{source}} (P95 Fetch)",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Per-Source Ingestion Fetch Duration P95 (Seconds)",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "description": "Rate of institutional API key lifecycle operations (create, rotate, revoke). Sudden clusters of key revocations highlight security incidents or key rotations.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Events / min",
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 20 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 25 },
      "id": 7,
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "max"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "sum by (action) (rate(fintext_audit_events_total{action=~\"api_key.*\"}[5m])) * 60",
          "legendFormat": "{{action}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "API Key Lifecycle Audit Operations (Create, Rotate, Revoke)",
      "type": "timeseries"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["fintext", "tenant-usage", "operations", "telemetry", "ingestion"],
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"]
  },
