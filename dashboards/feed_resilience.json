{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "FinText Alpha Vectorizer — Upstream Feed Resilience & Circuit Breaker Health",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "description": "Per-source circuit breaker state (0 = Closed [Normal], 1 = Half-Open [Probing], 2 = Open [Fast-Reject / Fallback Active]). Fixed cardinality: 5 institutional sources.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "State",
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto"
          },
          "mappings": [
            {
              "options": {
                "0": { "color": "green", "index": 0, "text": "CLOSED" },
                "1": { "color": "yellow", "index": 1, "text": "HALF-OPEN" },
                "2": { "color": "red", "index": 2, "text": "OPEN" }
              },
              "type": "value"
            }
          ],
          "max": 2,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 2 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "max"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "fintext_provider_state",
          "legendFormat": "{{source}} (State)",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Per-Source Circuit Breaker State Timeline",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "description": "Per-second rate of circuit breaker fallback activations when transitioning from Closed/Half-Open to Open state due to 5 consecutive failures or >=50% error ratio.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Activations / sec",
            "drawStyle": "line",
            "fillOpacity": 25,
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.05 },
              { "color": "red", "value": 0.2 }
            ]
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 2,
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "max"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "sum(rate(fintext_fallback_activations_total[5m])) by (source)",
          "legendFormat": "{{source}} (Fallback Rate)",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Fallback Activations Rate (Trips to Open)",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "description": "P95 event latency lag segmented by ingestion operational mode (Primary, Degraded, Stale). Degraded REST paths add bounded ~2-5s lag budget vs real-time socket streams.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "P95 Lag (Seconds)",
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1.0 },
              { "color": "red", "value": 5.0 }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "id": 3,
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "p95", "max"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum(rate(event_lag_seconds_bucket[5m])) by (le, mode))",
          "legendFormat": "Mode: {{mode}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Event Lag P95 by Mode (Primary vs Degraded vs Stale)",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "description": "Active degradation indicator gauge per feed source (1 = Fallback Active / Breaker Open or Stale, 0 = Primary WebSocket / Normal Ingestion).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "options": {
                "0": { "color": "green", "index": 0, "text": "PRIMARY (HEALTHY)" },
                "1": { "color": "red", "index": 1, "text": "FALLBACK ACTIVE" }
              },
              "type": "value"
            }
          ],
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "id": 4,
      "options": {
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "fintext_fallback_active",
          "legendFormat": "{{source}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Provider Fallback Active Status",
      "type": "gauge"
    },
    {
      "datasource": "Prometheus",
      "description": "P95 batch fetch wall-clock latency per upstream vendor source across primary and fallback ingestion paths.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Seconds",
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.25 },
              { "color": "red", "value": 1.0 }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 17 },
      "id": 5,
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "p95", "max"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum(rate(fetch_duration_seconds_bucket[5m])) by (le, source))",
          "legendFormat": "{{source}} (P95 Fetch)",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Per-Source Fetch Duration P95 (Seconds)",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "description": "Rate of emitted events marked with mode=stale when upstream vendors suffer extended outages (>10m for SEC EDGAR, or FOMC/Corporate Actions outages).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Stale Events / sec",
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "showPoints": "never"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.1 }
            ]
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 17 },
      "id": 6,
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "max"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "sum(rate(event_lag_seconds_count{mode=\"stale\"}[5m])) by (source)",
          "legendFormat": "{{source}} (Stale Rate)",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Stale Events Emission Rate",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "description": "Total ingestion errors per vendor source categorized by root cause reason (e.g. rate limit, disconnect, timeout).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Errors / min",
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 20 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 25 },
      "id": 7,
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "max"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "sum(rate(errors_total[5m]) * 60) by (source, reason)",
          "legendFormat": "{{source}} - {{reason}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Ingestion Error Rate by Source & Reason (Errors / Min)",
      "type": "timeseries"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["fintext", "resilience", "circuit-breaker", "telemetry", "ingestion"],
  "templating": {
    "list": [
