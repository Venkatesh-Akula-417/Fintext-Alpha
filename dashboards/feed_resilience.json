        "hide": 0,
        "includeAll": true,
        "label": "Source",
        "multi": true,
        "name": "source",
        "options": [],
        "query": {
          "query": "label_values(fintext_provider_state, source)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"]
  },
