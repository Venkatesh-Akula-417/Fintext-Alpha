# ============================================================================
# FinText Alpha Vectorizer — Git Exclusion Matrix & Allowlist
# ============================================================================

# ── 1. Executables, Compiled Libraries & Model Assets ────────────────────────
# Binary model weights & platform binaries are hosted on GitHub Releases (see docs/MODEL_ASSETS.md)
**/*.exe
**/*.dll
**/*.so
**/*.dylib
**/*.pdb
**/*.bin
**/*.pt
**/*.pth
**/*.onnx
**/*.safetensors
**/*.h5
**/*.ckpt

# Release archive directory: exclude large ZIP bundles, track checksum ledger
models_release_v1/*
!models_release_v1/SHA256SUMS.txt

# ── 2. Build Targets & Toolchain Artifacts ───────────────────────────────────
**/target/
target/
build/
dist/
**/.terraform/
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json

# ── 3. Heavy Data Formats & Compressed Archives ──────────────────────────────
**/*.parquet
**/*.csv
**/*.tsv
**/*.zip
**/*.tar.gz
**/*.jsonl
**/*.db
**/*.sqlite3

# Explicitly whitelist committed static seed configuration CSVs
!config/sector_mapping.csv

# ── 4. Generated Runtime Data & Storage Directories ──────────────────────────
**/data/
data/
# Preserve native Rust ingestion static test data
!rust/ingestion_engine/src/data/
!rust/ingestion_engine/src/data/**

# ── 5. Certified Audit Reports Allowlist ──────────────────────────────────────
# Retain cryptographically certified compliance ledgers & reports in logs/
**/logs/*
logs/*
!logs/load_test_report.json
!logs/rls_isolation_report.json
!logs/signal_quality_report.json
!logs/tenant_provisioning_report.json
!logs/tenant_deprovisioning_report.json
!logs/backup_restore_test_report.json
!logs/soak_report.json
!logs/soak_ledger.md
!logs/billing_flow_report.json
!logs/billing_reconciliation_report.json
!logs/infra_validate_report.json
!logs/.gitkeep
logs/soak_history.jsonl

# ── 6. Local Scratch, Tools & Historical Archive ─────────────────────────────
**/scratch/
scratch/
**/tools/
tools/
**/_archive/
_archive/

# ── 7. Secrets, Environment Variables & Virtual Environments ─────────────────
**/.env
.env
**/.venv/
**/venv/

# ── 8. Python & IDE Caches ───────────────────────────────────────────────────
**/.pytest_cache/
.pytest_cache/
**/.ipynb_checkpoints/
.ipynb_checkpoints/
**/*.pyc
**/__pycache__/

# ── 9. Ephemeral Local Server Logs & Development Task Artifacts ──────────────
server_stdout_*.log
server_stderr_*.log
task.md
