# Ignore all executables and system libraries anywhere
**/*.exe
**/*.dll
**/*.so
**/*.dylib
**/*.pdb

# Ignore all target and build directories
**/target/
target/
build/
dist/

# Ignore all model weights and checkpoints
**/*.bin
**/*.pt
**/*.pth
**/*.onnx
**/*.safetensors
**/*.h5
**/*.ckpt

# Ignore heavy data formats & archives
**/*.parquet
**/*.csv
**/*.tsv
**/*.zip
**/*.tar.gz
**/*.jsonl
**/*.db
**/*.sqlite3

# Ignore specific large data directories
**/data/
data/
# Do not ignore Rust source directories that are named "data"
!rust/ingestion_engine/src/data/
!rust/ingestion_engine/src/data/**
**/logs/
logs/
!logs/load_test_report.json
**/scratch/
scratch/
**/tools/
tools/
**/_archive/
_archive/
**/.env
.env
**/.venv/
**/venv/
**/__pycache__/

# Whitelist committed config CSVs
!config/sector_mapping.csv

# Ignore local server logs and dev task files
server_stdout_*.log
server_stderr_*.log
task.md
