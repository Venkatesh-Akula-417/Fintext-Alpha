# ══════════════════════════════════════════════════════════════════════════════
# FinText-Alpha-Vectorizer — Environment Configuration Template
# ══════════════════════════════════════════════════════════════════════════════

# ── Production Mode Guard ────────────────────────────────────────────
# PRODUCTION_MODE=1 (or "true"): fail-closed. Subsystems return 503 or
#   refuse startup when dependencies are unreachable. No silent in-memory
#   fallback. PRODUCTION_MODE env overrides config.yaml production_mode.
# PRODUCTION_MODE=0 (or "false"): development mode, fallbacks allowed.
# Unset: read config.yaml production_mode (default false).
PRODUCTION_MODE=0

# FINTEXT_ALLOW_IN_MEMORY_FALLBACK: dev-only escape hatch.
# In production mode (PRODUCTION_MODE=1), in-memory fallback is disabled
# and subsystems (auth, metering, audit) fail-closed when the database
# is unreachable. Set to 1 only for emergency rollback.
# Default: 0 (fail-closed in prod)
FINTEXT_ALLOW_IN_MEMORY_FALLBACK=0

# ── Ingestion Data Sources & Licensing Compliance ──────────────────────────────

#
# Data Source Enablement Flags (1 = enabled, 0 = disabled):
ENABLE_SEC_EDGAR=1
ENABLE_FINNHUB=1
ENABLE_POLYGON=1
ENABLE_STOCK_PRICE_INGESTION=1

# Phase 2 FOMC Collector (Public Domain 17 U.S.C. § 105 - 10ms micro-burst at 2:00 PM EST)
ENABLE_FOMC=0
FOMC_POLL_INTERVAL_MS=10
FOMC_BURST_DURATION_SECS=300
FOMC_STATEMENT_URL=https://www.federalreserve.gov/monetarypolicy/fomccalendars.htm


# ── Active Providers (Permitted / Internal Quantitative Analytics) ─────────────
# 1. Polygon.io Market Data (Options microstructure VPIN/GEX & Daily OHLCV stock bars)
# Note: Commercial license required for market data redistribution.
POLYGON_API_KEY=your_polygon_api_key_here
POLYGON_MOCK_MODE=0
POLYGON_STOCK_UNIVERSE=AAPL,MSFT,NVDA,GOOGL,AMZN,META,TSLA,SPY
STOCK_PRICE_LOOKBACK_DAYS=365

# 2. Finnhub Real-Time Financial News API Key (Live market news feed for internal analytics)
# Note: Commercial redistribution license required before external distribution.
FINNHUB_API_KEY=your_finnhub_api_key_here




# ── Storage Topology: Primary TimescaleDB & Optional Hot Cache ────────────────
ENABLE_TIMESCALEDB=true
TIMESCALE_PRIMARY=true
TIMESCALE_DB_URL=postgres://fintext:fintext@localhost:5432/fintext_metadata
TIMESCALE_MAX_CONNECTIONS=10
TIMESCALE_MOCK_FALLBACK=0

# QuestDB (Optional hot storage cache; disabled by default to minimize cloud cost)
QUESTDB_ENABLED=false
QUESTDB_URL=http://localhost:9000
QUESTDB_MOCK_FALLBACK=0

# ── Streaming Event Bus & Real-Time Messaging (Redpanda / Kafka) ──────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=sentiment-events
KAFKA_TOPIC_REALTIME=sentiment-updates
KAFKA_REALTIME_TOPIC=sentiment-updates
KAFKA_DLQ_TOPIC=sentiment-dlq
KAFKA_REPROCESS_TOPIC=sentiment-updates
KAFKA_MOCK_FALLBACK=0
KAFKA_MOCK_MODE=0

# ── API Server & Gateway ──────────────────────────────────────────────────────
PORT=8000
HOST=0.0.0.0
RUST_LOG=info
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
ADMIN_TOKEN=your_admin_dev_token_for_token_issuance
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
DATABASE_URL=postgres://fintext:fintext@localhost:5432/fintext_metadata

# ── NLP & Machine Learning Assets (ProsusAI FinBERT v3.1.0) ───────────────────
MODEL_DIR=models/finbert-finetuned
FINBERT_MODEL_DIR=models/finbert-finetuned
FINBERT_MODEL_PATH=models/finbert-finetuned/model.onnx
FINBERT_TOKENIZER_PATH=models/finbert-finetuned
MODEL_MANIFEST_PATH=config/models_manifest.json
ORT_CPU_THREADS=4
ORT_EXECUTION_PROVIDER=CPUExecutionProvider
ORT_INT8_ENABLE=1
NER_CPU_THREADS=2
NER_EXECUTION_PROVIDER=CPUExecutionProvider

# ── Model Drift Monitoring & Alert Dispatcher ─────────────────────────────────
MODEL_DRIFT_WEBHOOK_URL=http://localhost:8000/internal/alerts/drift
DRIFT_ALERT_LOG_PATH=logs/model_drift_alerts.log

# ── Audio Processing & ASR (Whisper.cpp) ──────────────────────────────────────
WHISPER_MODEL_PATH=models/whisper/ggml-base.en.bin
WHISPER_MOCK_FALLBACK=0

# ── Cross-Asset Lead-Lag Spillover Analytics ──────────────────────────────────
SPILLOVER_INTERVAL_SECS=3600
SPILLOVER_LOOKBACK_DAYS=30
SPILLOVER_CORR_THRESHOLD=0.3
SPILLOVER_MIN_HOURS=10
SPILLOVER_MAX_LAG_HOURS=24
SPILLOVER_MAX_TICKERS=50
SPILLOVER_MOCK_MODE=0

# ── Dead Letter Queue (DLQ) Auto-Reprocessor Worker ───────────────────────────
S3_QUARANTINE_BUCKET=fintext-dlq-quarantine
LOCAL_QUARANTINE_DIR=data/quarantine
DLQ_MAX_RETRIES=5
DLQ_INITIAL_BACKOFF_MS=100
DLQ_MAX_BACKOFF_MS=5000
DLQ_MOCK_MODE=0

# ── AI Latency & Performance Anomaly Detector ─────────────────────────────────
PROMETHEUS_URL=http://localhost:9090
PROMETHEUS_QUERY=sum(rate(http_request_duration_seconds_sum[5m])) / sum(rate(http_request_duration_seconds_count[5m]))
ANOMALY_THRESHOLD_ZSCORE=3.0
ANOMALY_WINDOW_SIZE=30
CHECK_INTERVAL_SECS=60
WEBHOOK_URL=

# ── Raw Data Archive (Apache Parquet & S3/MinIO Storage - Suite #265 & #273) ──
RAW_ARCHIVE_ENABLED=0
RAW_ARCHIVE_PROVIDER=local
RAW_ARCHIVE_BUCKET=fintext-raw-archive
RAW_ARCHIVE_PREFIX=raw
RAW_ARCHIVE_REGION=us-east-1
RAW_ARCHIVE_ENDPOINT=http://localhost:9000
RAW_ARCHIVE_ACCESS_KEY=your_s3_or_minio_access_key
RAW_ARCHIVE_SECRET_KEY=your_s3_or_minio_secret_key
RAW_ARCHIVE_BATCH_SIZE=1000
RAW_ARCHIVE_FLUSH_INTERVAL_SECS=60
RAW_ARCHIVE_LOCAL_PATH=data/archive
RAW_ARCHIVE_MOCK=0
RAW_ARCHIVE_LIFECYCLE_TRANSITION_DAYS=30
RAW_ARCHIVE_LIFECYCLE_EXPIRATION_DAYS=3650
RAW_ARCHIVE_VERIFY_UPLOAD=0

# ── Secrets Management Abstraction Layer ──────────────────────────────────────
# Provider: "env" (default, local environment variables) or "aws_secrets_manager"
SECRETS_PROVIDER=env
AWS_REGION=us-east-1
# Required when SECRETS_PROVIDER=aws_secrets_manager (JSON payload containing JWT_SECRET, ADMIN_TOKEN, DATABASE_URL, etc.)
AWS_SECRET_ARN=

# ── Stripe Subscription Billing & Webhook Automation ──────────────────────────
STRIPE_SECRET_KEY=sk_test_mock_stripe_key_for_dev
STRIPE_WEBHOOK_SECRET=whsec_fintext_test_webhook_signing_secret_2026
STRIPE_PRICE_PRO_MONTHLY=price_pro_monthly_mock
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_enterprise_monthly_mock
STRIPE_MOCK_MODE=0

# ── PIT Certificate Cryptographic Proof Archival (Suite #268) ────────────────
PIT_CERT_ARCHIVE_ENABLED=true
PIT_CERT_ARCHIVE_PROVIDER=local
PIT_CERT_ARCHIVE_BUCKET=fintext-pit-cert-archive
PIT_CERT_ARCHIVE_PREFIX=pit-cert
PIT_CERT_ARCHIVE_REGION=us-east-1
PIT_CERT_ARCHIVE_ENDPOINT=
PIT_CERT_ARCHIVE_ACCESS_KEY=
PIT_CERT_ARCHIVE_SECRET_KEY=
PIT_CERT_ARCHIVE_LOCAL_PATH=data/pit-cert-archive

# ── PostgreSQL Bi-Temporal Point-in-Time Reference Database (Suite #269) ─────
PIT_DB_ENABLED=false
PIT_DB_URL=postgres://fintext:fintext@localhost:5432/fintext_metadata
PIT_DB_FALLBACK_TO_JSON=true
PIT_DB_MAX_CONNECTIONS=10
PIT_DB_TIMEOUT_MS=3000

# ── Ingestion Bounded Concurrency & Backpressure Limiter (Suite #270) ─────────
MAX_CONCURRENT_TASKS=100
INPUT_QUEUE_CAPACITY=1000
TASK_TIMEOUT_MS=30000

# ── Database Circuit Breaker & Retry Policy (Suite #271) ─────────────────────
DB_BREAKER_ENABLED=true
DB_BREAKER_FAILURE_THRESHOLD=5
DB_BREAKER_RECOVERY_TIMEOUT_MS=30000
DB_BREAKER_HALF_OPEN_MAX_PROBES=2
DB_BREAKER_RETRY_ATTEMPTS=3
DB_BREAKER_RETRY_BASE_DELAY_MS=100
DB_BREAKER_RETRY_MAX_DELAY_MS=2000

# ── In-Memory Cache TTL & Capacity Governance (Suite #272) ───────────────────
CACHE_DEFAULT_TTL_SECONDS=300
CACHE_DEFAULT_MAX_CAPACITY=10000
CACHE_CLEANUP_INTERVAL_SECONDS=60
QUOTA_CACHE_TTL_SECONDS=300
QUOTA_CACHE_MAX_CAPACITY=10000
RATE_LIMIT_BUCKET_TTL_SECONDS=300
RATE_LIMIT_MAX_BUCKETS=10000
PROVIDER_HEALTH_CACHE_TTL_SECONDS=60
PROVIDER_HEALTH_CACHE_MAX_CAPACITY=1000
SCD2_CACHE_TTL_SECONDS=300
SCD2_CACHE_MAX_CAPACITY=5000
 
# ══════════════════════════════════════════════════════════════════════════════
# UNUSED / OPTIONAL CLOUD VARIABLES (kept for reference per UNUSED_KEYS.md)
# ══════════════════════════════════════════════════════════════════════════════
